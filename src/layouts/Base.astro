---
interface Props {
	title?: string;
}

const { title = 'Orbit Dev Sim' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Code+Pro:wght@400;500&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<a class="site-brand" href="/">Orbit</a>
				<nav aria-label="Main">
					<a href="/posts">Posts</a>
					<a href="/people">People</a>
					<a href="/projects">Projects</a>
					<a href="/teams">Teams</a>
				</nav>
			</div>
		</header>
		<main class="container">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container">
				<p>&copy; {new Date().getFullYear()} Orbit. Built for developers who care about craft.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		/* Palette */
		--color-bg: #f8fafc;
		--color-surface: #ffffff;
		--color-text: #0f172a;
		--color-text-muted: #475569;
		--color-text-light: #64748b;
		--color-border: #e2e8f0;
		--color-accent: #2563eb;
		--color-accent-hover: #1d4ed8;
		--color-accent-soft: #eff6ff;
		--color-code-bg: #1e293b;
		--color-code-text: #e2e8f0;

		/* Typography */
		--font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		--font-mono: 'Source Code Pro', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

		/* Spacing scale */
		--space-1: 0.25rem;
		--space-2: 0.5rem;
		--space-3: 0.75rem;
		--space-4: 1rem;
		--space-5: 1.25rem;
		--space-6: 1.5rem;
		--space-8: 2rem;
		--space-10: 2.5rem;
		--space-12: 3rem;
		--space-16: 4rem;
		--space-20: 5rem;

		/* Radii */
		--radius-sm: 0.375rem;
		--radius-md: 0.5rem;
		--radius-lg: 0.75rem;
	}

	* {
		box-sizing: border-box;
		margin: 0;
	}

	body {
		font-family: var(--font-sans);
		background: var(--color-bg);
		color: var(--color-text);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	.container {
		max-width: 72rem;
		margin-inline: auto;
		padding-inline: var(--space-6);
	}

	/* Header */
	.site-header {
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	.site-header .container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: var(--space-4);
	}
	.site-brand {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-text);
		text-decoration: none;
		letter-spacing: -0.02em;
	}
	.site-brand:hover {
		color: var(--color-accent);
	}
	.site-header nav {
		display: flex;
		gap: var(--space-6);
		align-items: center;
	}
	.site-header nav a {
		text-decoration: none;
		color: var(--color-text-muted);
		font-weight: 500;
		font-size: 0.9375rem;
		transition: color 0.15s ease;
	}
	.site-header nav a:hover {
		color: var(--color-accent);
	}

	/* Main */
	main.container {
		padding-block: var(--space-12);
		min-height: calc(100vh - 8rem);
	}

	/* Footer */
	.site-footer {
		border-top: 1px solid var(--color-border);
		background: var(--color-surface);
		padding-block: var(--space-8);
		color: var(--color-text-light);
		font-size: 0.875rem;
		text-align: center;
	}

	/* Typography */
	h1, h2, h3, h4 {
		line-height: 1.25;
		letter-spacing: -0.02em;
		font-weight: 700;
	}
	h1 { font-size: 2.25rem; margin-bottom: var(--space-6); }
	h2 { font-size: 1.5rem; margin-top: var(--space-10); margin-bottom: var(--space-4); }
	h3 { font-size: 1.125rem; margin-top: var(--space-8); margin-bottom: var(--space-3); }
	p { margin-bottom: var(--space-4); color: var(--color-text-muted); }
	a { color: var(--color-accent); text-decoration: none; }
	a:hover { text-decoration: underline; }

	/* Lists */
	ul, ol {
		padding-left: var(--space-6);
		margin-bottom: var(--space-4);
	}
	li { margin-bottom: var(--space-2); }

	/* Code */
	code {
		font-family: var(--font-mono);
		font-size: 0.875em;
		background: var(--color-accent-soft);
		color: var(--color-accent-hover);
		padding: 0.125rem 0.375rem;
		border-radius: var(--radius-sm);
	}
	pre {
		background: var(--color-code-bg);
		color: var(--color-code-text);
		padding: var(--space-5);
		border-radius: var(--radius-md);
		overflow-x: auto;
		margin-bottom: var(--space-6);
	}
	pre code {
		background: transparent;
		color: inherit;
		padding: 0;
		font-size: 0.875rem;
	}

	/* Utility classes */
	.text-muted { color: var(--color-text-muted); }
	.text-light { color: var(--color-text-light); }
	.text-sm { font-size: 0.875rem; }
	.text-lg { font-size: 1.125rem; }
	.font-semibold { font-weight: 600; }
	.mt-0 { margin-top: 0; }
	.mb-2 { margin-bottom: var(--space-2); }
	.mb-4 { margin-bottom: var(--space-4); }
	.mb-6 { margin-bottom: var(--space-6); }
	.mb-8 { margin-bottom: var(--space-8); }
	.mb-12 { margin-bottom: var(--space-12); }

	/* Card list */
	.card-list {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--space-4);
	}
	.card-list > li {
		margin: 0;
	}
	.card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-5) var(--space-6);
		transition: box-shadow 0.15s ease, border-color 0.15s ease;
	}
	.card:hover {
		border-color: #cbd5e1;
		box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
	}
	.card a {
		color: var(--color-text);
	}
	.card a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}
	.card h3 {
		margin: 0 0 var(--space-2);
		font-size: 1.0625rem;
	}
	.card p {
		margin: 0;
		font-size: 0.9375rem;
	}
	.card .meta {
		font-size: 0.8125rem;
		color: var(--color-text-light);
		margin-top: var(--space-2);
	}

	/* Hero */
	.hero {
		text-align: center;
		padding-block: var(--space-16) var(--space-12);
	}
	.hero h1 {
		font-size: 3rem;
		margin-bottom: var(--space-4);
		letter-spacing: -0.03em;
	}
	.hero p {
		font-size: 1.25rem;
		color: var(--color-text-muted);
		max-width: 40rem;
		margin-inline: auto;
	}

	/* Section header with "View all" link */
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: var(--space-4);
	}
	.section-header h2 {
		margin: 0;
	}
	.section-header a {
		font-size: 0.9375rem;
		font-weight: 500;
	}

	/* Grid for featured sections */
	.grid-2 {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-4);
	}
	.grid-3 {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-4);
	}

	/* Inline comma-separated list of links */
	.inline-links {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.inline-links li {
		margin: 0;
	}
	.tag {
		display: inline-block;
		background: var(--color-accent-soft);
		color: var(--color-accent);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
		font-size: 0.8125rem;
		font-weight: 500;
		text-decoration: none;
	}
	.tag:hover {
		background: #dbeafe;
		text-decoration: none;
	}

	@media (max-width: 640px) {
		.site-header .container {
			flex-direction: column;
			gap: var(--space-3);
		}
		.hero h1 {
			font-size: 2rem;
		}
		h1 { font-size: 1.75rem; }
	}
</style>
