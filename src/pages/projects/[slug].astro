---
import { getCollection, render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map(project => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const team = await getEntry(project.data.team);
const contributorEntries = await Promise.all(
	project.data.contributors.map(c => getEntry(c))
);
---

<Base title={project.data.title}>
	<h1>{project.data.title}</h1>
	<p>Team: <a href={`/teams/${project.data.team.id}`}>{team?.data.name ?? project.data.team.id}</a></p>
	{project.data.contributors.length > 0 && (
		<p>Contributors: {contributorEntries.map((c, i) => (
			<>
				{i > 0 && ', '}
				<a href={`/people/${c.id}`}>{c.data.name}</a>
			</>
		))}</p>
	)}
	<Content />
</Base>
