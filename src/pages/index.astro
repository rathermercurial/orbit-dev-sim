---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const people = await getCollection('people');
const posts = await getCollection('posts');
const projects = await getCollection('projects');
const teams = await getCollection('teams');
---

<Base title="Orbit Dev Sim">
	<h1>Orbit Dev Sim</h1>
	<section>
		<h2>People ({people.length})</h2>
		<ul>
			{people.map(p => <li><a href={`/people/${p.id}`}>{p.data.name}</a></li>)}
		</ul>
	</section>
	<section>
		<h2>Posts ({posts.length})</h2>
		<ul>
			{posts.map(p => <li><a href={`/posts/${p.id}`}>{p.data.title}</a> by {p.data.author.id}</li>)}
		</ul>
	</section>
	<section>
		<h2>Projects ({projects.length})</h2>
		<ul>
			{projects.map(p => <li><a href={`/projects/${p.id}`}>{p.data.title}</a> — team: {p.data.team.id}</li>)}
		</ul>
	</section>
	<section>
		<h2>Teams ({teams.length})</h2>
		<ul>
			{teams.map(t => <li><a href={`/teams/${t.id}`}>{t.data.name}</a></li>)}
		</ul>
	</section>
</Base>
